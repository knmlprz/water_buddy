# WodaPol (Water Buddy) — przykładowa konfiguracja środowiska
# Aplikacja korzysta wyłącznie z bezpłatnych, otwartych API publicznych bez kluczy API
# (ULDK GUGiK, NMT GUGiK, BDOT10k, Open-Meteo Archive/Forecast, Earth Search Sentinel-2,
# IUNG-PIB GeoServer, SoilGrids, GDOŚ Natura 2000, IMGW-PIB, Copernicus EDO).
# Żaden klucz API nie jest wymagany do uruchomienia aplikacji ani generowania raportów.

# Port serwera HTTP (domyślnie 3000)
PORT=3000

# Tryb pracy serwera: development | production
NODE_ENV=development

# Publiczny adres aplikacji (opcjonalny, wykorzystywany w środowiskach chmurowych)
APP_URL="http://localhost:3000"

# Opcjonalny klucz Gemini API (nieużywany w deterministycznym silniku rekomendacji KOWR)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: paid Open-Meteo plan key (removes the 10 000 calls/day limit)
OPEN_METEO_API_KEY=""
